<Routine Name="Filling_Simulation" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(Sim_Out_FillValveOpen)XIO(HMI_Sim_FillValveFailToClose)TON(FillValveCloseDelay,?,?);]]>
</Text>
