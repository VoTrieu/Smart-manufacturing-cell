<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(HMI_Cmd_Start)XIO(HMI_Cmd_Stop)XIO(HMI_Cmd_LoadBottle)XIO(HMI_Cmd_ClearCell)XIO(HMI_Cmd_ConveyorJog)XIO(HMI_Cmd_FillValveOpen)XIO(HMI_Cmd_RejectExtend)OTE(Recovery_CommandsReleased);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQU(Production_Sts_SequenceState,0)XIO(Sim_In_IndexComplete)OTE(Recovery_PhaseClear);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Reset is separate from Clear Cell and Start. Shared by every fault owner.]]>
</Comment>
<Text>
<![CDATA[XIO(S:FS)XIC(Sys_Sts_StartupReady)EQU(Sys_Sts_MachineState,30)XIC(Sys_Sts_EquipmentHome)XIC(Sys_Sts_CellEmpty)XIC(Sys_Sts_InjectionsClear)XIC(Recovery_CommandsReleased)XIC(Recovery_PhaseClear)XIC(ConfigurationValid)OTE(Sys_Sts_ResetAllowed);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[NEQ(Filling_Sts_State,20)NEQ(Filling_Sts_State,30)NEQ(Inspection_Sts_State,20)NEQ(Exit_Sts_State,20)NEQ(Exit_Sts_State,30)NEQ(Exit_Sts_State,40)NEQ(Exit_Sts_State,50)OTE(Sys_Sts_OperationsIdle);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Startup_Control" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Every transition to Run starts stopped and requires fresh mode/Start requests.]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)[MOV(0,Sys_Sts_MachineState) ,OTU(Sys_Sts_StartupReady) ,OTL(Startup_CheckPending) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Wait one complete simulation pass: photoeyes are cleared by prescan. Physical presence also catches a masked sensor.]]>
</Comment>
<Text>
<![CDATA[XIC(Startup_CheckPending)XIO(S:FS)[XIC(Production_Bottles[0].Occupied) ,XIC(Production_Bottles[1].Occupied) ,XIC(Production_Bottles[2].Occupied) ,XIC(Production_Bottles[3].Occupied) ,XIC(Sim_In_EntryPE) ,XIC(Sim_In_FillPE) ,XIC(Sim_In_InspectionPE) ,XIC(Sim_In_ExitPE) ,XIC(Sim_In_GoodExitPE) ,XIC(Sim_In_RejectExitPE) ,XIC(Sim_Sts_BottlesPresent) ,NEQ(Production_Sts_SequenceState,0) NEQ(Production_Sts_SequenceState,10) ,[EQU(Filling_Sts_State,20) ,EQU(Filling_Sts_State,30) ] ,EQU(Inspection_Sts_State,20) ,[EQU(Exit_Sts_State,20) ,EQU(Exit_Sts_State,30) ,EQU(Exit_Sts_State,40) ,EQU(Exit_Sts_State,50) ] ]OTL(Production_Flt_StartupRecoveryRequired);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Startup_CheckPending)XIO(S:FS)XIO(Production_Flt_StartupRecoveryRequired)[MOV(0,Production_Sts_SequenceState) ,MOV(0,Filling_Sts_State) ,MOV(0,Inspection_Sts_State) ,MOV(0,Exit_Sts_State) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Startup_CheckPending)XIO(S:FS)[OTL(Sys_Sts_StartupReady) ,OTU(Startup_CheckPending) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
