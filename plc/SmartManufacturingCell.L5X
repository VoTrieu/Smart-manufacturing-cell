<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(S:FS)XIC(Sys_Sts_StartupReady)XIC(Sys_Sts_AutoMode)XIO(Sys_Sts_ManualMode)EQU(Sys_Sts_MachineState,0)XIO(Sys_Sts_BlockingFault)XIC(Start_EquipmentReady)XIC(Start_CommandsReleased)OTE(Sys_Sts_StartAllowed);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
