<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(HMI_Cmd_Start)XIO(HMI_Cmd_Stop)XIO(HMI_Cmd_LoadBottle)XIO(HMI_Cmd_ClearCell)XIO(HMI_Cmd_ConveyorJog)XIO(HMI_Cmd_FillValveOpen)XIO(HMI_Cmd_RejectExtend)OTE(Production_ResetCommandsReleased);]]>
