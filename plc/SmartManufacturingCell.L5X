<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(HMI_Cmd_Start)ONS(StartRequestONS)XIC(Sys_Sts_StartAllowed)XIO(Sys_Sts_BlockingFault)EQU(Sys_Sts_MachineState,0)MOV(10,Sys_Sts_MachineState);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
