<Routine Name="Index_Simulation" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[NEQ(Production_Sts_SequenceState,20) ,XIC(S:FS) ,XIC(Production_Sts_ClearCellAccepted) ]OTU(Sim_In_IndexComplete);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(S:FS)EQU(Production_Sts_SequenceState,20)XIO(Production_Sts_ClearCellAccepted)XIC(Sim_Out_ConveyorRun)XIC(Sim_In_ConveyorRunning)XIO(Sim_In_IndexComplete)XIO(HMI_Sim_IndexJam)TON(IndexTravelDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(IndexTravelDelay.DN)ONS(IndexTransferONS)OTE(IndexTransferPulse);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(IndexTransferPulse)[XIC(Sim_InspectionOccupied) OTL(Sim_ExitOccupied) ,XIO(Sim_InspectionOccupied) OTU(Sim_ExitOccupied) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(IndexTransferPulse)[XIC(Sim_FillOccupied) OTL(Sim_InspectionOccupied) ,XIO(Sim_FillOccupied) OTU(Sim_InspectionOccupied) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(IndexTransferPulse)XIO(HMI_Sim_IndexPositionMismatch)[XIC(Sim_EntryOccupied) OTL(Sim_FillOccupied) ,XIO(Sim_EntryOccupied) OTU(Sim_FillOccupied) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Deliberately wrong physical Fill occupancy for the position-confirmation fault test.]]>
</Comment>
<Text>
<![CDATA[XIC(IndexTransferPulse)XIC(HMI_Sim_IndexPositionMismatch)[XIC(Sim_EntryOccupied) OTU(Sim_FillOccupied) ,XIO(Sim_EntryOccupied) OTL(Sim_FillOccupied) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(IndexTransferPulse)[OTL(Sim_In_IndexComplete) ,OTU(Sim_EntryOccupied) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
