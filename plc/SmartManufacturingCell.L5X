<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(FillValveCloseDelay.DN)OTE(Sim_In_FillValveClosed);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[GEQ(Filling_Sts_ActiveFillTimeMs,100)LEQ(Filling_Sts_ActiveFillTimeMs,3000)MOV(Filling_Sts_ActiveFillTimeMs,FillProcessDelay.PRE);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Sim_Out_FillValveOpen)XIC(Sim_FillOccupied)XIO(HMI_Sim_FillFailToComplete)TON(FillProcessDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
