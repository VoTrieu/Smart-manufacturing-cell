<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(S:FS)XIC(Sys_Sts_StartupReady)XIO(Sys_Sts_BlockingFault)EQU(Production_Sts_SequenceState,20)XIO(Sim_In_IndexComplete)TON(IndexTimeout,?,?);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(IndexTimeout.DN)OTL(Production_Flt_IndexTimeout);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIO(S:FS)XIC(Sys_Sts_StartupReady)XIO(Sys_Sts_BlockingFault)EQU(Production_Sts_SequenceState,30)XIO(Production_Sts_IndexCommitted)TON(IndexConfirmTimeout,?,?);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(IndexConfirmTimeout.DN)OTL(Production_Flt_IndexConfirmTimeout);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Debounce the normal one-pass load/departure update before declaring mismatch.]]>
</Comment>
<Text>
<![CDATA[XIO(S:FS)XIC(Sys_Sts_StartupReady)XIO(Sys_Sts_BlockingFault)EQU(Production_Sts_SequenceState,10)XIO(Sim_Out_ConveyorRun)XIO(Sim_In_ConveyorRunning)[[XIC(Production_Bottles[0].Occupied) XIO(Sim_In_EntryPE) ,XIO(Production_Bottles[0].Occupied) XIC(Sim_In_EntryPE) ] ,[XIC(Production_Bottles[1].Occupied) XIO(Sim_In_FillPE) ,XIO(Production_Bottles[1].Occupied) XIC(Sim_In_FillPE) ] ,[XIC(Production_Bottles[2].Occupied) XIO(Sim_In_InspectionPE) ,XIO(Production_Bottles[2].Occupied) XIC(Sim_In_InspectionPE) ] ,[XIC(Production_Bottles[3].Occupied) XIO(Sim_In_ExitPE) ,XIO(Production_Bottles[3].Occupied) XIC(Sim_In_ExitPE) ] ,XIC(Production_Bottles[2].Occupied) XIO(Production_Bottles[2].FillComplete) ,XIC(Production_Bottles[3].Occupied) XIO(Production_Bottles[3].InspectionComplete) ]TON(TrackingMismatchDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(TrackingMismatchDelay.DN)OTL(Production_Flt_TrackingMismatch);]]>
</Text>
</Rung>
