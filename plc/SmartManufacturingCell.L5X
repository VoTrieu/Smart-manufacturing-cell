<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(Production_Bottles[0].Occupied)XIO(Production_Bottles[1].Occupied)XIO(Production_Bottles[2].Occupied)XIO(Production_Bottles[3].Occupied)OTE(Production_TrackingEmpty);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(Sim_In_EntryPE)XIO(Sim_In_FillPE)XIO(Sim_In_InspectionPE)XIO(Sim_In_ExitPE)XIO(Sim_In_GoodExitPE)XIO(Sim_In_RejectExitPE)OTE(Production_SensorsClear);]]>
