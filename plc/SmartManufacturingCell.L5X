<Routine Name="Bottle_Loading" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(S:FS)XIC(Sys_Sts_StartupReady)XIO(Sys_Sts_BlockingFault)XIC(Sys_Sts_AutoMode)XIO(Sys_Sts_ManualMode)[EQU(Sys_Sts_MachineState,10) ,EQU(Sys_Sts_MachineState,20) ]EQU(Sys_Sts_MachineState,10)XIO(HMI_Cmd_Stop)XIO(HMI_Cmd_ClearCell)EQU(Production_Sts_SequenceState,10)XIO(Sim_Out_ConveyorRun)XIO(Sim_In_ConveyorRunning)XIO(Production_Bottles[0].Occupied)XIO(Sim_In_EntryPE)OTE(Production_Sts_LoadAllowed);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(HMI_Cmd_LoadBottle)ONS(LoadRequestONS)XIC(Production_Sts_LoadAllowed)OTE(Production_Sts_LoadAccepted);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Production_Sts_LoadAccepted)[OTL(Production_Bottles[0].Occupied) ,OTU(Production_Bottles[0].FillComplete) ,OTU(Production_Bottles[0].InspectionComplete) ,OTU(Production_Bottles[0].RejectRequired) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MOV(10,Production_Sts_LoadBlockReason);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(HMI_Cmd_Stop) ,XIC(HMI_Cmd_ClearCell) ]MOV(20,Production_Sts_LoadBlockReason);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(Sim_Out_ConveyorRun) ,XIC(Sim_In_ConveyorRunning) ]MOV(30,Production_Sts_LoadBlockReason);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(Production_Bottles[0].Occupied) ,XIC(Sim_In_EntryPE) ]MOV(40,Production_Sts_LoadBlockReason);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(Sys_Sts_BlockingFault) ,XIO(Sys_Sts_StartupReady) ]MOV(50,Production_Sts_LoadBlockReason);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Production_Sts_LoadAllowed)MOV(0,Production_Sts_LoadBlockReason);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Bottle_Tracking" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[if Production_Sts_SequenceState <> 30 then]]>
</Line>
<Line Number="1">
<![CDATA[	Production_Sts_IndexCommitted := 0;]]>
</Line>
<Line Number="2">
<![CDATA[elsif Production_Sts_IndexPositionsMatch AND NOT Production_Sts_IndexCommitted then]]>
</Line>
<Line Number="3">
<![CDATA[	]]>
</Line>
<Line Number="4">
<![CDATA[	// Copy downstream first to preserve seach source record.]]>
</Line>
<Line Number="5">
<![CDATA[	COP(Production_Bottles[2], Production_Bottles[3], 1);]]>
</Line>
<Line Number="6">
<![CDATA[	COP(Production_Bottles[1], Production_Bottles[2], 1);]]>
</Line>
<Line Number="7">
<![CDATA[	COP(Production_Bottles[0], Production_Bottles[1], 1);]]>
</Line>
<Line Number="8">
<![CDATA[	]]>
</Line>
<Line Number="9">
<![CDATA[ 	// Entry is empty after the confirmed movement.]]>
</Line>
<Line Number="10">
<![CDATA[    Production_Bottles[0].Occupied := 0;]]>
</Line>
<Line Number="11">
<![CDATA[    Production_Bottles[0].FillComplete := 0;]]>
</Line>
<Line Number="12">
<![CDATA[    Production_Bottles[0].InspectionComplete := 0;]]>
</Line>
<Line Number="13">
<![CDATA[    Production_Bottles[0].RejectRequired := 0;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[    Production_Sts_IndexCommitted := 1;]]>
</Line>
<Line Number="16">
<![CDATA[end_if;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Clear_Cell" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(Sim_Out_ConveyorRun)XIO(Sim_In_ConveyorRunning)XIO(Sim_Out_FillValveOpen)XIC(Sim_In_FillValveClosed)XIO(Sim_Out_RejectExtend)XIC(Sim_In_RejectRetracted)XIO(Sim_In_RejectExtended)XIO(Sim_Out_GoodDischargeRun)OTE(ClearCell_EquipmentReady);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(HMI_Cmd_Start)XIO(HMI_Cmd_Stop)XIO(HMI_Cmd_LoadBottle)XIO(HMI_Cmd_ConveyorJog)XIO(HMI_Cmd_FillValveOpen)XIO(HMI_Cmd_RejectExtend)XIO(HMI_Cmd_Reset)OTE(ClearCell_CommandsReleased);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(S:FS)XIC(Sys_Sts_StartupReady)[EQU(Sys_Sts_MachineState,0) ,EQU(Sys_Sts_MachineState,30) ]XIC(ClearCell_EquipmentReady)XIC(ClearCell_CommandsReleased)OTE(Production_Sts_ClearCellAllowed);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(HMI_Cmd_ClearCell)ONS(ClearCellRequestONS)XIC(Production_Sts_ClearCellAllowed)OTE(Production_Sts_ClearCellAccepted);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Recovery loss counts tracked bottles removed; not normal reject production.]]>
</Comment>
<Text>
<![CDATA[XIC(Production_Sts_ClearCellAccepted)XIC(Production_Bottles[0].Occupied)LES(Production_Stats_RecoveryLossCount,2147483647)ADD(Production_Stats_RecoveryLossCount,1,Production_Stats_RecoveryLossCount);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Production_Sts_ClearCellAccepted)[OTU(Production_Bottles[0].Occupied) ,OTU(Production_Bottles[0].FillComplete) ,OTU(Production_Bottles[0].InspectionComplete) ,OTU(Production_Bottles[0].RejectRequired) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Recovery loss counts tracked bottles removed; not normal reject production.]]>
</Comment>
<Text>
<![CDATA[XIC(Production_Sts_ClearCellAccepted)XIC(Production_Bottles[1].Occupied)LES(Production_Stats_RecoveryLossCount,2147483647)ADD(Production_Stats_RecoveryLossCount,1,Production_Stats_RecoveryLossCount);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Production_Sts_ClearCellAccepted)[OTU(Production_Bottles[1].Occupied) ,OTU(Production_Bottles[1].FillComplete) ,OTU(Production_Bottles[1].InspectionComplete) ,OTU(Production_Bottles[1].RejectRequired) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Recovery loss counts tracked bottles removed; not normal reject production.]]>
</Comment>
<Text>
<![CDATA[XIC(Production_Sts_ClearCellAccepted)XIC(Production_Bottles[2].Occupied)LES(Production_Stats_RecoveryLossCount,2147483647)ADD(Production_Stats_RecoveryLossCount,1,Production_Stats_RecoveryLossCount);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Production_Sts_ClearCellAccepted)[OTU(Production_Bottles[2].Occupied) ,OTU(Production_Bottles[2].FillComplete) ,OTU(Production_Bottles[2].InspectionComplete) ,OTU(Production_Bottles[2].RejectRequired) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Recovery loss counts tracked bottles removed; not normal reject production.]]>
</Comment>
<Text>
<![CDATA[XIC(Production_Sts_ClearCellAccepted)XIC(Production_Bottles[3].Occupied)LES(Production_Stats_RecoveryLossCount,2147483647)ADD(Production_Stats_RecoveryLossCount,1,Production_Stats_RecoveryLossCount);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Production_Sts_ClearCellAccepted)[OTU(Production_Bottles[3].Occupied) ,OTU(Production_Bottles[3].FillComplete) ,OTU(Production_Bottles[3].InspectionComplete) ,OTU(Production_Bottles[3].RejectRequired) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Production_Sts_ClearCellAccepted)MOV(0,Production_Sts_SequenceState);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Index_Confirmation" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[Production_Sts_IndexPositionsMatch :=]]>
</Line>
<Line Number="1">
<![CDATA[    (Production_Sts_SequenceState = 30)]]>
</Line>
<Line Number="2">
<![CDATA[    AND (]]>
</Line>
<Line Number="3">
<![CDATA[        (Sys_Sts_MachineState = 10)]]>
</Line>
<Line Number="4">
<![CDATA[        OR (Sys_Sts_MachineState = 20)]]>
</Line>
<Line Number="5">
<![CDATA[    )]]>
</Line>
<Line Number="6">
<![CDATA[    AND Sys_Sts_AutoMode]]>
</Line>
<Line Number="7">
<![CDATA[    AND NOT Sys_Sts_ManualMode]]>
</Line>
<Line Number="8">
<![CDATA[    AND NOT Sys_Sts_BlockingFault]]>
</Line>
<Line Number="9">
<![CDATA[    AND NOT Sim_Out_ConveyorRun]]>
</Line>
<Line Number="10">
<![CDATA[    AND NOT Sim_In_ConveyorRunning]]>
</Line>
<Line Number="11">
<![CDATA[    AND NOT Production_Bottles[3].Occupied]]>
</Line>
<Line Number="12">
<![CDATA[    AND NOT Sim_In_EntryPE]]>
</Line>
<Line Number="13">
<![CDATA[    AND NOT (Sim_In_FillPE XOR Production_Bottles[0].Occupied)]]>
</Line>
<Line Number="14">
<![CDATA[    AND NOT (Sim_In_InspectionPE XOR Production_Bottles[1].Occupied)]]>
</Line>
<Line Number="15">
<![CDATA[    AND NOT (Sim_In_ExitPE XOR Production_Bottles[2].Occupied);]]>
</Line>
</STContent>
</Routine>
<Routine Name="Index_Permissives" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(Sim_Out_ConveyorRun)XIO(Sim_In_ConveyorRunning)XIO(Sim_Out_FillValveOpen)XIC(Sim_In_FillValveClosed)XIO(Sim_Out_RejectExtend)XIC(Sim_In_RejectRetracted)XIO(Sim_In_RejectExtended)XIO(Sim_Out_GoodDischargeRun)OTE(Index_EquipmentReady);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(HMI_Cmd_Stop)XIO(HMI_Cmd_ClearCell)XIO(HMI_Cmd_Reset)XIO(HMI_Cmd_ConveyorJog)XIO(HMI_Cmd_FillValveOpen)XIO(HMI_Cmd_RejectExtend)OTE(Index_CommandsReleased);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(S:FS)XIC(Sys_Sts_StartupReady)XIO(Sys_Sts_BlockingFault)XIC(Sys_Sts_AutoMode)XIO(Sys_Sts_ManualMode)[EQU(Sys_Sts_MachineState,10) ,EQU(Sys_Sts_MachineState,20) ]EQU(Sys_Sts_MachineState,10)XIO(HMI_Cmd_Stop)XIO(HMI_Cmd_ClearCell)EQU(Production_Sts_SequenceState,10)XIC(Production_Sts_StationsReady)XIC(Production_Sts_IndexDemand)XIC(Index_EquipmentReady)XIC(Index_CommandsReleased)XIO(Production_Sts_LoadAccepted)OTE(Production_Sts_IndexAllowed);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Index_Readiness" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIO(Production_Bottles[1].Occupied) ,XIC(Production_Bottles[1].FillComplete) ]NEQ(Filling_Sts_State,20)NEQ(Filling_Sts_State,30)OTE(Filling_ReadyForIndex);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(Production_Bottles[2].Occupied) ,XIC(Production_Bottles[2].InspectionComplete) ]NEQ(Inspection_Sts_State,20)OTE(Inspection_ReadyForIndex);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(Production_Bottles[3].Occupied)[EQU(Exit_Sts_State,0) ,EQU(Exit_Sts_State,60) ]OTE(Exit_ReadyForIndex);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Filling_ReadyForIndex)XIC(Inspection_ReadyForIndex)XIC(Exit_ReadyForIndex)OTE(Production_Sts_StationsReady);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(Production_Bottles[0].Occupied) ,XIC(Production_Bottles[1].Occupied) ,XIC(Production_Bottles[2].Occupied) ]OTE(Production_Sts_IndexDemand);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
