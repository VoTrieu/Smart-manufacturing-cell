</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQU(Sys_Sts_MachineState,30)XIO(Sys_Sts_BlockingFault)[XIC(Conveyor_Sts_ResetAccepted) ,XIC(Filling_Sts_ResetAccepted) ,XIC(Reject_Sts_ResetAccepted) ,XIC(Inspection_Sts_ResetAccepted) ,XIC(Exit_Sts_ResetAccepted) ,XIC(Production_Sts_ResetAccepted) ]MOV(0,Sys_Sts_MachineState);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Stop waits for active stations and the current index/confirmation; waiting bottles remain.]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Sts_MachineState,20)XIO(Sys_Sts_BlockingFault)XIC(Sys_Sts_EquipmentHome)XIC(Sys_Sts_OperationsIdle)[EQU(Production_Sts_SequenceState,0) ,EQU(Production_Sts_SequenceState,10) ]MOV(0,Sys_Sts_MachineState);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQU(Sys_Sts_MachineState,10)XIC(HMI_Cmd_Stop)XIO(Sys_Sts_BlockingFault)MOV(20,Sys_Sts_MachineState);]]>
