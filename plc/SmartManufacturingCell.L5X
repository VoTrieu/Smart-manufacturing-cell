<![CDATA[XIO(Sim_Out_ConveyorRun)XIO(Sim_In_ConveyorRunning)XIO(Sim_Out_FillValveOpen)XIC(Sim_In_FillValveClosed)XIO(Sim_Out_RejectExtend)XIC(Sim_In_RejectRetracted)XIO(Sim_In_RejectExtended)XIO(Sim_Out_GoodDischargeRun)OTE(Sys_Sts_EquipmentHome);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(Production_Bottles[0].Occupied)XIO(Production_Bottles[0].FillComplete)XIO(Production_Bottles[0].InspectionComplete)XIO(Production_Bottles[0].RejectRequired)XIO(Production_Bottles[1].Occupied)XIO(Production_Bottles[1].FillComplete)XIO(Production_Bottles[1].InspectionComplete)XIO(Production_Bottles[1].RejectRequired)XIO(Production_Bottles[2].Occupied)XIO(Production_Bottles[2].FillComplete)XIO(Production_Bottles[2].InspectionComplete)XIO(Production_Bottles[2].RejectRequired)XIO(Production_Bottles[3].Occupied)XIO(Production_Bottles[3].FillComplete)XIO(Production_Bottles[3].InspectionComplete)XIO(Production_Bottles[3].RejectRequired)OTE(Recovery_TrackingClear);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(Sim_In_EntryPE)XIO(Sim_In_FillPE)XIO(Sim_In_InspectionPE)XIO(Sim_In_ExitPE)XIO(Sim_In_GoodExitPE)XIO(Sim_In_RejectExitPE)XIO(Sim_Sts_BottlesPresent)OTE(Recovery_SensorsClear);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Recovery_TrackingClear)XIC(Recovery_SensorsClear)OTE(Sys_Sts_CellEmpty);]]>
