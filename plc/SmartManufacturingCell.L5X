<Routine Name="Production_Statistics" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// One event per confirmed departure. Recovery clear losses are counted separately.]]>
</Line>
<Line Number="1">
<![CDATA[IF Exit_Sts_GoodCompletePulse OR Exit_Sts_RejectCompletePulse THEN]]>
</Line>
<Line Number="2">
<![CDATA[    IF Production_Stats_TotalCount < 2147483647 THEN]]>
</Line>
<Line Number="3">
<![CDATA[        Production_Stats_TotalCount := Production_Stats_TotalCount + 1;]]>
</Line>
<Line Number="4">
<![CDATA[        IF Exit_Sts_GoodCompletePulse THEN]]>
</Line>
<Line Number="5">
<![CDATA[            Production_Stats_GoodCount := Production_Stats_GoodCount + 1;]]>
</Line>
<Line Number="6">
<![CDATA[        ELSE]]>
</Line>
<Line Number="7">
<![CDATA[            Production_Stats_RejectCount := Production_Stats_RejectCount + 1;]]>
</Line>
<Line Number="8">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="9">
<![CDATA[    ELSE]]>
</Line>
<Line Number="10">
<![CDATA[        Production_Sts_CounterSaturated := 1;]]>
</Line>
<Line Number="11">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="12">
<![CDATA[    IF Stats_HasPreviousExit THEN]]>
</Line>
<Line Number="13">
<![CDATA[        Production_Stats_LastCycleSeconds := Stats_ExitElapsed;]]>
</Line>
<Line Number="14">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="15">
<![CDATA[    Stats_HasPreviousExit := 1;]]>
</Line>
<Line Number="16">
<![CDATA[    Stats_ExitElapsed := 0.0;]]>
</Line>
<Line Number="17">
<![CDATA[    Stats_WindowCount := Stats_WindowCount + 1;]]>
</Line>
<Line Number="18">
<![CDATA[    Production_Bottles[3].Occupied := 0;]]>
</Line>
<Line Number="19">
<![CDATA[    Production_Bottles[3].FillComplete := 0;]]>
</Line>
<Line Number="20">
<![CDATA[    Production_Bottles[3].InspectionComplete := 0;]]>
</Line>
<Line Number="21">
<![CDATA[    Production_Bottles[3].RejectRequired := 0;]]>
</Line>
<Line Number="22">
<![CDATA[END_IF;]]>
</Line>
<Line Number="23">
<![CDATA[IF (Sys_Sts_MachineState = 10) OR (Sys_Sts_MachineState = 20) THEN]]>
</Line>
<Line Number="24">
<![CDATA[    Production_Stats_RunSeconds := Production_Stats_RunSeconds + 0.02;]]>
</Line>
<Line Number="25">
<![CDATA[    Stats_ExitElapsed := Stats_ExitElapsed + 0.02;]]>
</Line>
<Line Number="26">
<![CDATA[ELSIF Sys_Sts_MachineState = 30 THEN]]>
</Line>
<Line Number="27">
<![CDATA[    Production_Stats_FaultSeconds := Production_Stats_FaultSeconds + 0.02;]]>
</Line>
<Line Number="28">
<![CDATA[ELSE]]>
</Line>
<Line Number="29">
<![CDATA[    Production_Stats_StoppedSeconds := Production_Stats_StoppedSeconds + 0.02;]]>
</Line>
<Line Number="30">
<![CDATA[END_IF;]]>
</Line>
<Line Number="31">
<![CDATA[Stats_RateElapsed := Stats_RateElapsed + 0.02;]]>
</Line>
<Line Number="32">
<![CDATA[IF Stats_RateElapsed >= 60.0 THEN]]>
</Line>
<Line Number="33">
<![CDATA[    Production_Stats_RatePerMinute := Stats_WindowCount * 60.0 / Stats_RateElapsed;]]>
</Line>
<Line Number="34">
<![CDATA[    Stats_RateElapsed := 0.0;]]>
</Line>
<Line Number="35">
<![CDATA[    Stats_WindowCount := 0;]]>
</Line>
<Line Number="36">
<![CDATA[END_IF;]]>
</Line>
<Line Number="37">
<![CDATA[IF S:FS THEN]]>
</Line>
<Line Number="38">
<![CDATA[    Stats_ExitElapsed := 0.0;]]>
</Line>
<Line Number="39">
<![CDATA[    Stats_HasPreviousExit := 0;]]>
</Line>
<Line Number="40">
<![CDATA[    Stats_RateElapsed := 0.0;]]>
</Line>
<Line Number="41">
<![CDATA[    Stats_WindowCount := 0;]]>
</Line>
<Line Number="42">
<![CDATA[    Production_Stats_RatePerMinute := 0.0;]]>
</Line>
<Line Number="43">
<![CDATA[END_IF;]]>
</Line>
<Line Number="44">
<![CDATA[IF StatisticsResetAccepted THEN]]>
</Line>
<Line Number="45">
<![CDATA[    Production_Stats_TotalCount := 0;]]>
</Line>
<Line Number="46">
<![CDATA[    Production_Stats_GoodCount := 0;]]>
</Line>
<Line Number="47">
<![CDATA[    Production_Stats_RejectCount := 0;]]>
</Line>
<Line Number="48">
<![CDATA[    Production_Stats_RecoveryLossCount := 0;]]>
</Line>
<Line Number="49">
<![CDATA[    Production_Stats_RunSeconds := 0.0;]]>
</Line>
<Line Number="50">
<![CDATA[    Production_Stats_StoppedSeconds := 0.0;]]>
</Line>
<Line Number="51">
<![CDATA[    Production_Stats_FaultSeconds := 0.0;]]>
</Line>
<Line Number="52">
<![CDATA[    Production_Stats_LastCycleSeconds := 0.0;]]>
</Line>
<Line Number="53">
<![CDATA[    Production_Stats_RatePerMinute := 0.0;]]>
</Line>
<Line Number="54">
<![CDATA[    Production_Sts_CounterSaturated := 0;]]>
</Line>
<Line Number="55">
<![CDATA[    Stats_ExitElapsed := 0.0;]]>
</Line>
<Line Number="56">
<![CDATA[    Stats_HasPreviousExit := 0;]]>
</Line>
<Line Number="57">
<![CDATA[    Stats_RateElapsed := 0.0;]]>
</Line>
<Line Number="58">
<![CDATA[    Stats_WindowCount := 0;]]>
</Line>
<Line Number="59">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Statistics_Reset" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(HMI_Cmd_ResetStatistics)ONS(StatisticsResetONS)EQU(Sys_Sts_MachineState,0)XIC(Sys_Sts_CellEmpty)XIC(Sys_Sts_EquipmentHome)XIO(HMI_Cmd_Start)OTE(StatisticsResetAccepted);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
