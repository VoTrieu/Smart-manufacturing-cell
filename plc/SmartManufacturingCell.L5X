<Routines>
<Routine Name="Conveyor_Control" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(S:FS)XIC(Sys_Sts_StartupReady)XIO(Sys_Sts_BlockingFault)XIO(Conveyor_Flt_FailToStart)XIC(Sim_In_FillValveClosed)XIO(Sim_Out_FillValveOpen)XIC(Sim_In_RejectRetracted)XIO(Sim_In_RejectExtended)XIO(Sim_Out_RejectExtend)XIO(Sim_Out_GoodDischargeRun)OTE(Conveyor_MovementAllowed);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
