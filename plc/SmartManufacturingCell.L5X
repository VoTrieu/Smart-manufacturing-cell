<Text>
<![CDATA[XIO(HMI_Sim_ConveyorFailToStart)XIO(HMI_Sim_FillValveFailToClose)XIO(HMI_Sim_RejectFailToExtend)XIO(HMI_Sim_RejectFailToRetract)XIO(HMI_Sim_IndexJam)XIO(HMI_Sim_IndexPositionMismatch)XIO(HMI_Sim_FillFailToComplete)XIO(HMI_Sim_InspectionFailToComplete)XIO(HMI_Sim_GoodDischargeJam)XIO(HMI_Sim_RejectDischargeJam)XIO(HMI_Sim_BottleMissingAtFill)OTE(Sys_Sts_InjectionsClear);]]>
