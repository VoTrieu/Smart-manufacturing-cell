<Routine Name="Configuration_Control" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Validate before equipment can sample configuration into timer presets.]]>
</Comment>
<Text>
<![CDATA[GEQ(Cfg_FillTimeMs,100)LEQ(Cfg_FillTimeMs,3000)GEQ(Cfg_InspectionTimeMs,100)LEQ(Cfg_InspectionTimeMs,2000)OTE(ConfigurationValid);]]>
</Text>
