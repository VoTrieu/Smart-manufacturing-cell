<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(S:FS)[OTU(Sys_Sts_AutoMode) ,OTU(Sys_Sts_ManualMode) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(S:FS)XIC(Sys_Sts_StartupReady)EQU(Sys_Sts_MachineState,0)XIO(Sys_Sts_BlockingFault)XIC(Sys_Sts_EquipmentHome)XIO(HMI_Cmd_Start)XIO(HMI_Cmd_Stop)XIO(HMI_Cmd_LoadBottle)XIO(HMI_Cmd_ClearCell)XIO(HMI_Cmd_ConveyorJog)XIO(HMI_Cmd_FillValveOpen)XIO(HMI_Cmd_RejectExtend)XIO(HMI_Cmd_Reset)OTE(ModeChangeAllowed);]]>
