</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(HMI_Cmd_Stop)XIO(HMI_Cmd_LoadBottle)XIO(HMI_Cmd_ClearCell)XIO(HMI_Cmd_ConveyorJog)XIO(HMI_Cmd_FillValveOpen)XIO(HMI_Cmd_RejectExtend)XIO(HMI_Cmd_Reset)OTE(Start_CommandsReleased);]]>
</Text>
